# Backend FastAPI (Cloud Run). Phase 7 deploy : legacy URL active.
NEXT_PUBLIC_API_BASE_URL="https://prt-prod-backend-y5iagyfila-ew.a.run.app"

# Bearer de secours quand aucun ID token Firebase n'est présent.
# Utile tant que le backend tourne en PRT_AUTH_DISABLE=1. Mettre "" une fois
# l'auth backend activée pour forcer un vrai login.
NEXT_PUBLIC_DEMO_BEARER="demo"

# --- Firebase Auth (config web PUBLIQUE, pas un secret) --------------------
# Console Firebase → Paramètres du projet → Vos applications → Web → SDK config.
# Tant que API_KEY/APP_ID sont absents, le frontend reste en mode démo (pas de login).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="price-tracker-prod-01.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="price-tracker-prod-01"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="price-tracker-prod-01.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="683154425349"
NEXT_PUBLIC_FIREBASE_APP_ID=""
