# Copier en .env et remplir les valeurs pour le dev local
# Ne JAMAIS committer le .env rempli

GOOGLE_CLOUD_PROJECT=price-tracker-prod

# Mot de passe Cloud SQL (récupéré via : gcloud secrets versions access latest --secret=db-password)
PRT_DB_PASSWORD=

# Optionnel — si tu veux pointer sur un autre bucket/fichier
# PRT_BRONZE_BUCKET=price-tracker-prod-01-bronze
# PRT_CATALOGUE_PARQUET_BLOB=prices.parquet

# Dev only
PRT_OIDC_DISABLE=true
